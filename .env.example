# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Simulator ---------------------------------------------------------
SIM_SENDING_APP=SYN-EHR
SIM_FACILITIES=SYNH-CHN,SYNH-BLR        # one batch file per facility per window
SIM_ADMISSIONS_PER_DAY=12               # across all facilities
SIM_FAULT_RATE=0.03                     # share of messages deliberately broken or duplicated
SIM_BATCH_ENVELOPE=false                # true wraps files in FHS/BHS ... BTS/FTS
SIM_TZ_OFFSET=+0530
SIM_SEED=                               # set for reproducible output, e.g. demo
SIM_OUTPUT_DIR=output

# --- GCP landing bucket (hospital side only creates objects there) -----
GCP_PROJECT_ID=hl7-fhir-pipeline
GCP_LANDING_BUCKET=
GCP_LANDING_PREFIX=incoming/
SIM_UPLOAD_ENABLED=false                # true: live mode uploads after each batch

# Option 1 (recommended for a laptop): your own login
#   gcloud auth application-default login --impersonate-service-account=hospital-sender@PROJECT.iam.gserviceaccount.com
# Option 2: a key file for the hospital-sender service account (keep it outside the repo)
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/keys/hospital-sender.json
