{
  "name": "patient-generator",
  "version": "1.0.0",
  "description": "Legacy hospital EHR simulator: generates HL7v2 ADT batch files and sends them to a GCP landing bucket",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "sim:backfill": "node simulator/cli.js backfill --days 7",
    "sim:tick": "node simulator/cli.js tick",
    "sim:live": "node simulator/cli.js live --every 15",
    "sim:upload": "node simulator/cli.js upload",
    "sim:upload:dry": "node simulator/cli.js upload --dry-run",
    "sim:status": "node simulator/cli.js status",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "bootstrap": "^5.2.2",
    "csv-parser": "^3.0.0",
    "express": "^4.18.1",
    "fs": "^0.0.1-security",
    "http": "^0.0.1-security",
    "path": "^0.12.7",
    "string-template": "^1.0.0",
    "websocket": "^1.0.34"
  }
}
